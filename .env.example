# Copy this file to .env and fill in. Never commit .env.

# Option A (local development): Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=

# Option B (Cloud Run / Vertex AI): uncomment these instead of the key
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Model: check AI Studio for the current Gemini Flash model name and paste it here
GEMINI_MODEL=gemini-2.5-flash

# Optional: read evidence from BigQuery dataset (after running scripts/load_bigquery.ps1)
# ARQON_BQ_DATASET=arqon
# Optional: store officer decisions in Firestore
# ARQON_FIRESTORE=1

# Force offline mode (no Gemini calls)
# ARQON_OFFLINE=1
